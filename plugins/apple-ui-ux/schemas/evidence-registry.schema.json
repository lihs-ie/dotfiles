{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lihs.local/schemas/apple-ui-ux-evidence-registry.schema.json",
  "title": "Apple Public UI UX Evidence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot": {"type": "string", "pattern": "^apple-public-ui-ux@[0-9]{4}\\.[0-9]{2}$"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "level", "source_kind", "title", "source", "retrieved_at", "summary", "status"],
        "properties": {
          "identifier": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
          "level": {"enum": ["L1", "L2", "L3", "L4"]},
          "source_kind": {"enum": ["apple_hig", "apple_developer_documentation", "apple_wwdc", "observation_protocol", "expert_heuristic"]},
          "title": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date"},
          "summary": {"type": "string", "minLength": 1},
          "status": {"enum": ["confirmed", "provisional", "deprecated"]}
        }
      }
    }
  }
}
