{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lihs.local/schemas/apple-ui-ux-rule-catalog.schema.json",
  "title": "Apple Public UI UX Rule Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "version", "title", "module", "evidence", "normative_strength", "severity", "enforcement", "predicate", "measurement", "verification"],
        "properties": {
          "identifier": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "module": {"enum": ["navigation", "adaptivity", "state", "typography", "layout", "color", "accessibility", "interaction", "motion", "visual-system", "ipad", "privacy", "destructive"]},
          "profiles": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "normative_strength": {"enum": ["must", "should", "observed"]},
          "severity": {"enum": ["error", "warning", "advisory"]},
          "enforcement": {"enum": ["hard", "warning", "advisory"]},
          "predicate": {"type": "string", "minLength": 1},
          "measurement": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string"}}, "additionalProperties": true},
          "verification": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["planned", "implemented"]}, "verifier": {"type": "string"}}}
        }
      }
    }
  }
}
